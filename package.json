{
  "name": "@hexfleet/backend",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["db"],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "npm run db:generate --workspace @hexfleet/db",
    "db:push": "npm run db:push --workspace @hexfleet/db",
    "db:migrate": "npm run db:migrate --workspace @hexfleet/db",
    "db:studio": "npm run db:studio --workspace @hexfleet/db"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@hexfleet/db": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "multer": "^1.4.5-lts.1"
  }
}
